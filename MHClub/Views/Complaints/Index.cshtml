@model IEnumerable<MHClub.Domain.Models.Complaint>
@{
    ViewData["Title"] = "Жалобы пользователей";
}

<h1 class="mb-4">Жалобы пользователей</h1>

<div class="table-responsive mb-4">
  <table class="table table-striped table-hover align-middle">
      <thead>
          <tr>
              <th>Объявление</th>
              <th>Пользователь</th>
              <th>Комментарий</th>
              <th>Действия</th>
          </tr>
      </thead>
      <tbody>
          @foreach(var complaint in Model)
          {
              <tr data-complaint-id="@complaint.Id">
                  <td>
                      <a href="@Url.Action("Single", "Ads", new { id = complaint.AdId })">
                          @complaint.Ad?.Name
                      </a>
                  </td>
                  <td>
                      <a href="@Url.Action("Profile", "Profile", new { userId = complaint.UserId })">
                          @complaint.User?.Email
                      </a>
                  </td>
                  <td>@complaint.Description</td>
                  <td class="text-center">
                      <button type="button"
                              class="btn btn-outline-secondary btn-sm me-2 ignore-btn"
                              data-id="@complaint.Id"
                              title="Игнорировать жалобу">
                          <span class="iconify" data-icon="mdi:close" data-inline="false"></span>
                      </button>
                      <button type="button"
                              class="btn btn-outline-danger btn-sm delete-ad-btn"
                              data-id="@complaint.Id"
                              title="Удалить объявление">
                          <span class="iconify" data-icon="mdi:delete" data-inline="false"></span>
                      </button>
                  </td>
              </tr>
          }
      </tbody>
  </table>
</div>

@section Scripts {
<script>
document.addEventListener("DOMContentLoaded", function() {
    var solveUrl = '@Url.Action("SolveComplaint", "Complaints")';
    
    document.querySelectorAll(".ignore-btn").forEach(function(btn) {
        btn.addEventListener("click", function() {
            var id = this.dataset.id;
            if(!confirm("Игнорировать эту жалобу?")) return;
            fetch(solveUrl + "?complaintId=" + id + "&deleteAd=false", { method: "POST" })
                .then(res => res.text())
                .then(() => {
                    var row = document.querySelector('tr[data-complaint-id="'+id+'"]');
                    if(row) row.remove();
                });
        });
    });

    document.querySelectorAll(".delete-ad-btn").forEach(function(btn) {
        btn.addEventListener("click", function() {
            var id = this.dataset.id;
            if(!confirm("Удалить объявление и подтвердить жалобу?")) return;
            fetch(solveUrl + "?complaintId=" + id + "&deleteAd=true", { method: "POST" })
                .then(res => res.text())
                .then(() => {
                    var row = document.querySelector('tr[data-complaint-id="'+id+'"]');
                    if(row) row.remove();
                });
        });
    });
});
</script>
}
