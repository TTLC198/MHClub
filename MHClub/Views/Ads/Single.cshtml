@model MHClub.Models.Ads.AdsIndexViewModel
@using System.Security.Claims
@using MHClub.Domain.Models.Enums
@using MHClub.Utils
@{
    Layout = "_Layout";
    ViewData["Title"] = Model.Name + (Model.IsArchived == true ? " (Архивное)" : "");
    var userRole = User.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Role)?.Value ?? "User";
}

<div class="container my-5">
    <div class="row">
        <!-- Галерея и главное изображение -->
        <div class="col-md-6 d-flex">
            <!-- Мини-превью -->
            <div class="d-flex flex-column gap-3 me-4">
                @{
                    var i = 0;
                }
                @if (Model.Images?.Count == 0)
                {
                    <img src="/images/no-photo.png"
                         class="thumb-img rounded-2 shadow-sm"
                         style="width: 64px; height: 64px; object-fit: cover; cursor: pointer;"
                         data-src="/images/no-photo.png"
                         data-counter="@i"/>
                    i++;
                }
                @foreach (var img in Model.Images ?? Enumerable.Empty<string>())
                {
                    var thumbUrl = Url.Action("Get", "Media", new { path = img.GetLocalPath() });
                    <img src="@thumbUrl"
                         class="thumb-img rounded-2 shadow-sm"
                         style="width: 64px; height: 64px; object-fit: cover; cursor: pointer;"
                         data-src="@thumbUrl"
                         data-counter="@i"/>
                    i++;
                }
            </div>
            <!-- Главное изображение с контролами -->
            <div class="flex-grow-1 position-relative" style="height: fit-content;">
                <div id="carousel" class="carousel slide mb-3">
                    <div class="carousel-inner">
                        @{
                            var firstImage = true;
                        }
                        @if (Model.Images?.Count == 0)
                        {
                            <div class="carousel-item@(firstImage ? Html.Raw(" active") : Html.Raw(""))">
                                <img src="/images/no-photo.png"
                                     class="w-100 rounded-3 shadow-sm"
                                     data-src="/images/no-photo.png"/>
                            </div>
                        }
                        @foreach (var img in Model.Images ?? Enumerable.Empty<string>())
                        {
                            <div class="carousel-item@(firstImage ? Html.Raw(" active") : Html.Raw(""))">
                                @{
                                    var thumbUrl = string.IsNullOrEmpty(img) ? "/images/no-photo.png" : Url.Action("Get", "Media", new { path = img.GetLocalPath() });
                                }
                                <img src="@thumbUrl"
                                     class="w-100 rounded-3 shadow-sm"
                                     data-src="@thumbUrl"/>
                            </div>
                            firstImage = false;
                        }
                    </div>
                </div>
                <a class="carousel-control-prev" data-bs-target="#carousel" role="button"
                   data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                </a>
                <a class="carousel-control-next" data-bs-target="#carousel" role="button"
                   data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                </a>
            </div>
        </div>

        <!-- Детали объявления -->
        <div class="col-md-6">
            <h2 class="fw-bold mb-3 d-flex align-items-center">
                <span>@Model.Name</span>
                @if (Model.IsArchived == true)
                {
                    <span class="text-muted fs-5 ms-2">(Архивное)</span>
                } 
                @if (Model.IsDeleted == true)
                {
                    <span class="text-muted fs-5 ms-2">(Удалено админом)</span>
                }
                @if (User.Identity?.IsAuthenticated == true && Model.IsOwn != true && userRole != "Admin")
                {
                    <!-- Кнопка избранное: просто звездочка без рамки -->
                    <button id="fav-button"
                            type="button"
                            class="btn btn-link p-0 ms-3 text-dark"
                            data-fav="@(Model.IsFavourite)"
                            style="font-size: 1.25rem; line-height: 1;">
                        @if (Model.IsFavourite == false)
                        {
                            <span class="iconify" data-icon="mdi:star-outline" style="font-size: 1.25rem;"></span>
                        }
                        else
                        {
                            <span class="iconify" data-icon="mdi:star" style="font-size: 1.25rem;"></span>
                        }
                    </button>
                }
            </h2>

            <h3 class="fs-2 fw-bold mb-3">
                @($"{Model.Cost:N0}₽")
            </h3>

            <div class="d-flex gap-2 mb-4">
                @if (Model.IsOwn == true)
                {
                    <a href="@Url.Action("Edit", "Ads", new { id = Model.Id })"
                       class="btn btn-outline-dark rounded-2">
                        Редактировать
                    </a>

                    @if (Model.IsArchived == true)
                    {
                        <button
                            data-bs-toggle="modal"
                            data-bs-target="#restoreStaticBackdrop"
                            type="button"
                            class="btn btn-dark rounded-2">
                            Восстановить объявление
                        </button>
                    }
                    else
                    {
                        <button
                            data-bs-toggle="modal"
                            data-bs-target="#staticBackdrop"
                            type="button"
                            class="btn btn-outline-dark rounded-2">
                            Удалить
                        </button>
                    }
                }
            </div>

            <h5 class="mb-2">Описание:</h5>
            <p class="mb-4 ad-description">@Model.Description</p>

            <h5 class="mb-2">Характеристики:</h5>
            <dl class="row">
                <dt class="col-sm-6">Страна производителя:</dt>
                <dd class="col-sm-6">@Model.ManufactureCountry</dd>
                <dt class="col-sm-6">Количество:</dt>
                <dd class="col-sm-6">@Model.Quantity</dd>
                <dt class="col-sm-6">Состояние:</dt>
                @{
                    var condition = Model.Condition?.Name ?? "Неизвестно";
                }
                <dd class="col-sm-6">@condition</dd>
                <dt class="col-sm-6">Дата публикации:</dt>
                <dd class="col-sm-6">@Model.CreationDate.ToString("dd MMMM yyyy")</dd>
            </dl>

            @if (Model.ChildrenAds != null && Model.ChildrenAds.Any())
            {
                <div class="children-header mb-3">
                    <h5 class="mb-0">Декомпозиция:</h5>
                    @if (Model.IsOwn == true)
                    {
                        <button
                            type="button"
                            class="add-child-btn"
                            title="Добавить объявление"
                            onclick="location.href='@Url.Action("Create", "Ads", new { parentAdId = Model.Id })';">
                            <span class="iconify" data-icon="mdi:plus"></span>
                        </button>
                    }
                </div>
                <div class="d-flex flex-column gap-2">
                    @foreach (var child in Model.ChildrenAds.Where(ad => ad.StatusId != (int)StatusType.Hidden))
                    {
                        <div class="child-ad-card">
                            <div class="child-ad-card-image"
                                 onclick="location.href='@Url.Action("Single", "Ads", new { id = child.Id })';">
                                @if (!string.IsNullOrEmpty(child.Images?.FirstOrDefault()))
                                {
                                    <img
                                        src="@Url.Action("Get", "Media", new { path = child.Images?.FirstOrDefault()?.GetLocalPath() })"
                                        alt=""/>
                                }
                                else
                                {
                                    <img
                                        src="/images/no-photo.png"
                                        alt=""/>
                                }
                            </div>

                            <div class="child-ad-card-body"
                                 onclick="location.href='@Url.Action("Single", "Ads", new { id = child.Id })';">
                                <h3 class="child-ad-card-title text-truncate limit-chars">@child.Name</h3>
                                <p class="child-ad-card-text text-truncate limit-chars">@child.Description</p>
                            </div>

                            @if (Model.IsOwn == true)
                            {
                                <div class="child-ad-card-actions">
                                    <button
                                        type="button"
                                        class="btn btn-link p-0"
                                        data-bs-toggle="modal"
                                        data-bs-target="#staticChildrenBackdrop"
                                        data-bs-whatever="@child.Id">
                                        <span class="iconify" data-icon="mdi:trash"></span>
                                    </button>
                                    <button
                                        type="button"
                                        class="btn btn-link p-0"
                                        onclick="location.href='@Url.Action("Edit", "Ads", new { id = child.Id })';">
                                        <span class="iconify" data-icon="mdi:pencil"></span>
                                    </button>
                                </div>
                            }
                        </div>
                    }
                </div>
            }

            @if (Model.ParentAd != null)
            {
                <h5 class="mb-2">Основное:</h5>
                <div class="child-ad-card">
                    <div class="child-ad-card-image"
                         onclick="location.href='@Url.Action("Single", "Ads", new { id = @Model.ParentAd.Id })';">
                        @if (!string.IsNullOrEmpty(@Model.ParentAd.Images?.FirstOrDefault()))
                        {
                            <img
                                src="@Url.Action("Get", "Media", new { path = @Model.ParentAd.Images?.FirstOrDefault()?.GetLocalPath() })"
                                alt=""/>
                        }
                        else
                        {
                            <img
                                src="/images/no-photo.png"
                                alt=""/>
                        }
                    </div>

                    <div class="child-ad-card-body"
                         onclick="location.href='@Url.Action("Single", "Ads", new { id = @Model.ParentAd.Id })';">
                        <h3 class="child-ad-card-title text-truncate limit-chars">@Model.ParentAd.Name</h3>
                        <p class="child-ad-card-text text-truncate limit-chars">@Model.ParentAd.Description</p>
                    </div>
                </div>
            }

            <!-- Информация о публикаторе -->
            <h5 class="mb-2">Информация о публикаторе:</h5>
            <div class="card publisher-card p-3 rounded-2 shadow-sm mb-4">
                <div class="d-flex align-items-center">
                    @if (!string.IsNullOrEmpty(Model.UserProfileDto?.ImageUrl))
                    {
                        <img
                            src="@Url.Action("Get", "Media", new { path = Model.UserProfileDto.ImageUrl.GetLocalPath() })"
                            class="rounded-circle me-3"
                            style="width:48px; height:48px; object-fit:cover;" alt="Avatar"/>
                    }
                    else
                    {
                        <img src="~/images/no-photo.png"
                             class="rounded-circle me-3"
                             style="width:48px; height:48px; object-fit:cover;"
                             alt="no avatar"/>
                    }
                    <div>
                        <a href="@Url.Action("Profile", "Profile", new { userId = Model.UserProfileDto.Id })"
                           class="text-dark fw-semibold mb-1 d-block">
                            @Model.UserProfileDto.Name
                        </a>
                        <p class="mb-1">
                            Рейтинг:
                            <strong class="fw-semibold">
                                @(Model.UserProfileDto.Rating.HasValue ? Model.UserProfileDto.Rating.Value.ToString("0.00") : "–")
                            </strong>
                            (@Model.UserProfileDto.ReviewsCount отзывов)
                        </p>
                    </div>
                </div>
                <p class="mb-1">Кол-во объявлений: @Model.UserProfileDto.AdsCount</p>
                <p class="mb-1">Зарегистрирован: @Model.UserProfileDto.DateOfRegistration.ToString("dd MMMM yyyy")</p>
                <p class="mb-0">Телефон: @Model.UserProfileDto.Phone</p>
            </div>

            @if (Model.IsOwn != true && User.Identity?.IsAuthenticated == true && userRole != "Admin")
            {
                <!-- Пожаловаться на объявление -->
                <button
                    id="openComplaintBtn"
                    type="button"
                    class="btn btn-outline-dark rounded-2 w-100 mb-3">
                    Пожаловаться на объявление
                </button>
            }
            @if (userRole == "Admin")
            {
                if (Model.StatusId == 1)
                {
                    <button
                        data-bs-toggle="modal"
                        data-bs-target="#staticBackdrop"
                        type="button"
                        class="btn btn-outline-dark rounded-2">
                        Удалить
                    </button>
                }
            }
        </div>
    </div>
</div>

<!-- Оверлей для масштабирования -->
<div class="modal fade" id="photoModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-3 shadow-sm">
            <div class="modal-body p-0">
                <img id="modalImage" class="w-100" style="object-fit: contain; max-height:80vh;"/>
            </div>
            <div class="modal-footer border-0 justify-content-center">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Закрыть</button>
            </div>
        </div>
    </div>
</div>

<!-- Модальные окна удаления/восстановления -->
<div class="modal fade" id="staticBackdrop" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
     aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="staticBackdropLabel">Вы действительно хотите удалить объявление?</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Нет</button>
                @using (Html.BeginForm("Delete", "Ads", new { Model.Id }, FormMethod.Post))
                {
                    <button type="submit" class="btn btn-primary">Да</button>
                }
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="staticChildrenBackdrop" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
     aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="staticChildrenBackdropLabel">Вы действительно хотите удалить дочернее
                    объявление?</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Нет</button>
                @using (Html.BeginForm("Delete", "Ads", new { Model.Id }, FormMethod.Post, false, new { id = "deleteChildForm" }))
                {
                    <button type="submit" class="btn btn-primary">Да</button>
                }
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="restoreStaticBackdrop" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
     aria-labelledby="restoreStaticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="restoreStaticBackdropLabel">Вы действительно хотите восстановить
                    объявление?</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Нет</button>
                @using (Html.BeginForm("Restore", "Ads", new { Model.Id }, FormMethod.Post))
                {
                    <button type="submit" class="btn btn-primary">Да</button>
                }
            </div>
        </div>
    </div>
</div>

<!-- Модальное окно для жалобы -->
<div class="modal fade" id="complaintModal" tabindex="-1" aria-labelledby="complaintModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-3 shadow-sm">
            <div class="modal-header">
                <h5 class="modal-title" id="complaintModalLabel">Оставить жалобу</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <label class="form-label">Ваша претензия</label>
                <textarea id="complaintText"
                          class="form-control"
                          rows="4"
                          placeholder="Расскажите, что вам не понравилось"
                          required></textarea>
            </div>
            <div class="modal-footer">
                <button type="button"
                        class="btn btn-outline-dark rounded-2"
                        data-bs-dismiss="modal">
                    Закрыть
                </button>
                <button id="submitComplaintBtn"
                        type="button"
                        class="btn btn-dark rounded-2">
                    Оставить
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const thumbs = Array.from(document.querySelectorAll('.thumb-img'));

            var exampleModal = document.getElementById('staticChildrenBackdrop')
            exampleModal.addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget
                var childId = button.getAttribute('data-bs-whatever')
                var deleteChildForm = document.getElementById('deleteChildForm');
                deleteChildForm.action = '/Ads/' + childId + '/Delete';
            })

            function updateMain(counter) {
                const carousel = new bootstrap.Carousel('#carousel');
                carousel.to(counter);
            }

            thumbs.forEach(thumb => thumb.addEventListener('click', () => {
                updateMain(thumb.dataset.counter);
            }));

            // Показать окно жалобы
            const openComplaintBtn = document.getElementById("openComplaintBtn");
            openComplaintBtn?.addEventListener("click", () => {
                const complaintModal = new bootstrap.Modal(document.getElementById("complaintModal"));
                complaintModal.show();
            });

            // Обработка отправки жалобы через AJAX
            const submitComplaintBtn = document.getElementById("submitComplaintBtn");
            submitComplaintBtn?.addEventListener("click", () => {
                const description = document.getElementById("complaintText").value.trim();
                if (!description) {
                    alert("Пожалуйста, введите текст жалобы.");
                    return;
                }

                const complaintDto = {
                    AdId: @Model.Id,
                    Description: description
                };

                fetch('@Url.Action("Create", "Complaints")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(complaintDto)
                })
                    .then(response => response.json())
                    .then(result => {
                        if (result === true) {
                            // Закрываем модалку и выводим уведомление
                            const bsModal = bootstrap.Modal.getInstance(document.getElementById("complaintModal"));
                            bsModal.hide();
                            alert("Жалоба успешно отправлена.");
                        } else {
                            alert("Не удалось отправить жалобу.");
                        }
                    })
                    .catch(() => {
                        alert("Произошла ошибка при отправке жалобы.");
                    });
            });

            // Обработка кнопки "Избранное"
            $("#fav-button").click(function () {
                const isFav = $(this).data("fav");
                console.log(isFav);
                $.ajax({
                    url: '/Favourites?adId=@Model.Id&isFavourite=' + !isFav,
                    type: 'POST',
                    cache: false,
                    async: true,
                })
                    .done(function (result) {
                        $("#fav-button").data("fav", !isFav);
                        if (!isFav) {
                            $("#fav-button").html('<span class="iconify" data-icon="mdi:star" style="font-size: 1.25rem;"></span>');
                        } else {
                            $("#fav-button").html('<span class="iconify" data-icon="mdi:star-outline" style="font-size: 1.25rem;"></span>');
                        }
                    });
            });
        });
    </script>
}
