@model MHClub.Models.Ads.AdsCreateViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Редактирование объявления - " + Model.Name;
    var showSuccessPopup = ViewBag.Success != null && (bool)ViewBag.Success;
}

<style>
    .condition-selected {
        background-color: #EAEAEA !important;
        color: #000 !important;
    }
</style>


@using (Html.BeginForm("Create", "Ads", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <div class="container mt-4">
        <div class="card shadow-sm p-4">
            <div class="d-flex align-items-center mb-4">
                <i class="bi-chevron-left fs-4 me-2" style="cursor:pointer;"
                   onclick="location.href='@ViewBag.ReturnUrl';"></i>
                <h4 class="mb-0">@ViewData["Title"]</h4>
            </div>

            <div class="row g-4">
                <!-- Название -->
                <div class="col-12">
                    <label class="form-label fw-bold mb-1">Название объявления</label>
                    @Html.TextBoxFor(m => m.Name, new { @class = "form-control bg-light", placeholder = "Например: Коллекционная монета 1905 г.", style = "border: none; background-color: #EAEAEA;" })
                    @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger" })
                </div>

                <!-- Состояние -->
                <div class="col-12">
                    <label class="form-label fw-bold mb-1">Состояние</label>
                    <div class="btn-group" role="group" aria-label="Состояние" id="state-group">
                        @foreach (var cond in (List<SelectListItem>)ViewBag.Conditions)
                        {
                            var isSelected = Model.ConditionId.HasValue && Model.ConditionId.Value.ToString() == cond.Value;
                            string inputId = "Condition_" + cond.Value;
                            <input type="radio" id="@inputId" name="ConditionId" value="@cond.Value" class="d-none"
                                   @(isSelected ? "checked" : "")/>
                            <label for="@inputId"
                                   class="btn @(isSelected ? "bg-secondary text-white" : "bg-light text-muted") rounded-pill me-2 state-btn"
                                   style="border: none; cursor: pointer;">
                                @cond.Text
                                @if (isSelected)
                                {
                                    <i class="bi-check-lg ms-1"></i>
                                }
                            </label>
                        }
                    </div>
                    @Html.ValidationMessageFor(m => m.ConditionId, "", new { @class = "text-danger" })
                </div>

                <input type="hidden" id="CategoryId" name="CategoryId" value="@Model.CategoryId" />
                <div class="mb-3">
                    @Html.LabelFor(m => m.Category, new { @class = "form-label fw-bold" })
                    @Html.TextBox("Category", Model.Category?.Name ?? "Категория не выбрана!", new {
                        @class = "form-control bg-light rounded-2",
                        placeholder = "Введите категорию",
                        style = "border: none; background-color: #EAEAEA !important;",
                        disabled="disabled"
                    })
                    @Html.ValidationMessageFor(m => m.Category, "", new { @class = "text-danger small" })
                    <div class="form-text text-muted mt-1">Нельзя редактировать категорию активного объявления</div>
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.ManufactureCountry, new { @class = "form-label fw-bold" })
                    @Html.DropDownListFor(m => m.ManufactureCountry, Model.CountriesSelect ?? [],
                        "Выберите страну-производитель", new { @class = "form-select bg-light", style = "border: none; background-color: #EAEAEA !important;" })
                    @Html.ValidationMessageFor(m => m.ManufactureCountry, "", new { @class = "text-danger" })
                </div>

                <!-- Описание -->
                <div class="col-12">
                    <label class="form-label fw-bold mb-1">Описание</label>
                    @Html.TextAreaFor(m => m.Description, new { @class = "form-control bg-light", placeholder = "Расскажите о вашем предмете", style = "border: none; background-color: #EAEAEA;", rows = 4 })
                    @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger" })
                </div>

                <!-- Фотографии -->
                <div class="col-12">
                    <label class="form-label fw-bold mb-1">Фотографии</label>
                    <div id="photoContainer" class="d-flex flex-wrap gap-2">
                        <!-- Сюда динамически добавляются слоты -->
                    </div>
                    <div class="form-text text-muted mt-1">Максимум 7 фотографий</div>
                </div>

                <!-- Цена -->
                <div class="col-12">
                    <label class="form-label fw-bold mb-1">Стоимость</label>
                    @Html.TextBoxFor(m => m.Cost, new { @class = "form-control bg-light", placeholder = "Введите стоимость вашего товара", style = "border: none; background-color: #EAEAEA;" })
                    @Html.ValidationMessageFor(m => m.Cost, "", new { @class = "text-danger" })
                </div>

                <!-- Кнопка Разместить -->
                <div class="col-12 mt-3">
                    <button type="submit" class="btn btn-dark w-100">Разместить объявление</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Модальное окно об успешном размещении -->
<div class="modal fade" id="successModal" aria-labelledby="successModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-3 shadow-sm">
            <div class="modal-header border-bottom-0">
                <h5 class="modal-title" id="successModalLabel">Успешно!</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
            </div>
            <div class="modal-body text-center py-4">
                <p class="mb-3">Ваше объявление успешно <изменено></изменено>.</p>
                <button type="button" class="btn btn-dark px-4" data-bs-dismiss="modal"
                        onclick="location.href='@Url.Action("Index", "Ads")';">
                    Хорошо
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="photoModal" …>
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-3 shadow-sm">
            <div class="modal-body p-0">
                <img id="modalImage" class="w-100" style="object-fit: contain; max-height:80vh;" />
            </div>
            <div class="modal-footer border-0 justify-content-center">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Закрыть</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Логика выбора состояния: переключаем классы у меток
        document.querySelectorAll('.state-btn').forEach(label => {
            label.addEventListener('click', function (e) {
                // Скрытый radio привязываем
                const inputId = label.getAttribute('for');
                document.getElementById(inputId).checked = true;

                // Сбрасываем стили у всех
                document.querySelectorAll('.state-btn').forEach(lb => {
                    lb.classList.remove('condition-selected', 'text-white');
                    lb.classList.add('bg-light', 'text-muted');
                    // Удаляем галочку, если есть
                    const ic = lb.querySelector('i.bi-check-lg');
                    if (ic) ic.remove();
                });

                // Подсвечиваем текущий
                label.classList.remove('bg-light', 'text-muted');
                label.classList.add('condition-selected', 'text-white');
                // Добавляем галочку
                const checkIcon = document.createElement('i');
                checkIcon.className = 'bi-check-lg ms-1';
                label.appendChild(checkIcon);
            });
        });

        // Максимум слотов
        const MAX_PHOTOS = 7;

        // При загрузке страницы добавляем первый "плюс"-слот
        document.addEventListener('DOMContentLoaded', function () {
            addPhotoSlot();
            var showPopup = @showSuccessPopup.ToString().ToLower();
            console.log(showPopup);
            if (showPopup) {
                var successModal = new bootstrap.Modal(document.getElementById('successModal'), {});
                successModal.show();
            }
        });

        function addPhotoSlot() {
            const container = document.getElementById('photoContainer');
            const currentSlots = container.querySelectorAll('.photo-slot').length;
            if (currentSlots >= MAX_PHOTOS) return;

            const index = currentSlots;
            const slotDiv = document.createElement('div');
            slotDiv.className = 'photo-slot position-relative';
            slotDiv.style = 'width:100px; height:100px;';

            // Скрытый <input type="file" name="Images">
            const fileInput = document.createElement('input');
            fileInput.type = 'file';
            fileInput.name = 'Images';
            fileInput.accept = 'image/*';
            fileInput.className = 'd-none';
            fileInput.dataset.index = index;
            fileInput.onchange = function (e) {
                handleFileSelect(e, slotDiv, fileInput);
            };

            // Нарисуем кнопку «+» через Iconify
            const plusDiv = document.createElement('div');
            plusDiv.className = 'photo-plus border bg-white rounded d-flex justify-content-center align-items-center';
            plusDiv.style = 'width:100%; height:100%; cursor:pointer;';
            plusDiv.innerHTML = '<span class="iconify" data-icon="mdi:plus" style="font-size: 1.5rem; color: #999;"></span>';

            plusDiv.onclick = function () {
                fileInput.click();
            };

            slotDiv.appendChild(fileInput);
            slotDiv.appendChild(plusDiv);
            container.appendChild(slotDiv);
        }

        function handleFileSelect(event, slotDiv, fileInput) {
            const file = fileInput.files[0];
            if (!file) return;

            if (!file.type.startsWith('image/')) {
                alert('Разрешены только изображения!');
                fileInput.value = '';
                return;
            }

            const reader = new FileReader();
            reader.onload = function (e) {
                // Очищаем слот, оставляем <input> и добавляем превью + кнопку удаления
                slotDiv.innerHTML = '';
                slotDiv.appendChild(fileInput);

                const imgWrapper = document.createElement('div');
                imgWrapper.className = 'position-relative';
                imgWrapper.style = 'width:100%; height:100%; border-radius:8px; overflow:hidden;';

                const img = document.createElement('img');
                img.src = e.target.result;
                img.className = 'img-thumbnail';
                img.style = 'width:100%; height:100%; object-fit: cover; cursor: pointer;';
                img.onclick = function () {
                    document.getElementById('modalImage').src = e.target.result;
                    const bsModal = new bootstrap.Modal(document.getElementById('photoModal'));
                    bsModal.show();
                };

                // Кнопка удаления
                const delBtn = document.createElement('button');
                delBtn.type = 'button';
                delBtn.className = 'btn btn-danger btn-sm position-absolute top-0 end-0';
                delBtn.style = 'padding: 2px 6px; font-size: 0.75rem;';
                delBtn.innerHTML = '&times;';
                delBtn.onclick = function () {
                    slotDiv.remove();
                    refreshPhotoSlots();
                };

                imgWrapper.appendChild(img);
                imgWrapper.appendChild(delBtn);
                slotDiv.appendChild(imgWrapper);

                // Если после добавления слотов меньше 7, создаём новый «+»-слот
                setTimeout(() => {
                    const totalSlots = document.querySelectorAll('#photoContainer .photo-slot').length;
                    if (totalSlots < MAX_PHOTOS) {
                        addPhotoSlot();
                    }
                }, 10);
            };
            reader.readAsDataURL(file);
        }

        function refreshPhotoSlots() {
            const container = document.getElementById('photoContainer');
            const slots = container.querySelectorAll('.photo-slot');
            slots.forEach((slot, idx) => {
                const inp = slot.querySelector('input[type="file"]');
                if (inp) {
                    inp.dataset.index = idx;
                }
            });
            // Если нет свободных «+»-слотов и общее число < MAX_PHOTOS, добавляем ещё один «+»
            const hasPlus = Array.from(slots).some(s => s.querySelector('.photo-plus') !== null);
            if (!hasPlus && slots.length < MAX_PHOTOS) {
                addPhotoSlot();
            }
        }
    </script>
}